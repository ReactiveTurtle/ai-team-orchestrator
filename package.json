    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "blessed": "^0.1.81",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
